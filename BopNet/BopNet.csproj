<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UseEfCoreSourceGenerators>true</UseEfCoreSourceGenerators>
        <StripSymbols>true</StripSymbols>
        <DebugType>portable</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="libsodium" Version="1.0.22" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
        <PackageReference Include="NetCord" Version="1.0.0-beta.21" />
        <PackageReference Include="NetCord.Hosting" Version="1.0.0-beta.21" />
        <PackageReference Include="NetCord.Hosting.Services" Version="1.0.0-beta.21" />
        <PackageReference Include="NetCord.Services" Version="1.0.0-beta.21" />

        <None Update="appsettings.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>

        <PackageReference Include="SQLite" Version="3.53.4" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="tracks\" />
    </ItemGroup>

</Project>
