<Project>
    <PropertyGroup>
        <UseMacOSNativeLibraries Condition="'$(StaticLinkNetCord)' != 'true' and ('$(RuntimeIdentifier)' == 'osx-arm64' or ('$(RuntimeIdentifier)' == '' and '$(NETCoreSdkRuntimeIdentifier)' == 'osx-arm64'))">true</UseMacOSNativeLibraries>
    </PropertyGroup>
    <ItemGroup Condition="'$(UseMacOSNativeLibraries)' == 'true'">
        <None Remove="Native/osx-arm64/**/*" />
        <None Include="Native/osx-arm64/*.dylib" Link="%(Filename)%(Extension)"
              CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
              ExcludeFromSingleFile="true" />
        <None Include="Native/osx-arm64/licenses/**/*;Native/osx-arm64/versions.txt"
              Link="native-licenses/%(RecursiveDir)%(Filename)%(Extension)"
              CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
              ExcludeFromSingleFile="true" />
    </ItemGroup>
</Project>
