<Project>
    <PropertyGroup Condition="'$(StaticLinkNetCord)' == 'true'">
        <NativeLibraryDirectory Condition="'$(NativeLibraryDirectory)' == ''">$(MSBuildThisFileDirectory)linux-x64</NativeLibraryDirectory>
    </PropertyGroup>
    <ItemGroup Condition="'$(StaticLinkNetCord)' == 'true'">
        <DirectPInvoke Include="libdave;libsodium;opus" />
        <!-- libdave contains its MLS/BoringSSL dependencies in a combined archive. -->
        <NativeLibrary Include="$(NativeLibraryDirectory)/libdave.a" />
        <NativeLibrary Include="$(NativeLibraryDirectory)/libsodium.a" />
        <NativeLibrary Include="$(NativeLibraryDirectory)/libopus.a" />
        <LinkerArg Include="-lstdc++" />
        <LinkerArg Include="-lm" />
        <LinkerArg Include="-lpthread" />
        <LinkerArg Include="-ldl" />
    </ItemGroup>
</Project>
